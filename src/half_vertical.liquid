<div class="layout layout--col gap--small content_area">
  <div class="value value--large md:value--xxlarge" data-value-fit="true" data-value-fit-max-height="150">
    <span>{{ headline | default: 'Unable to confirm.' }}</span>
  </div>

  <div class="description lg:description--xlarge">
    <span>{{ subheadline | default: 'Status check unavailable.' }}</span>
  </div>

  <div class="description lg:description--large">
    <span>{{ footer | default: 'No evidence available.' }}</span>
  </div>
</div>

<div class="title_bar">
  <span class="title">Is He Dead Yet?</span>
  <span class="instance">{{ subject | default: 'Unknown' }}</span>
</div>