<div class="layout layout--col">
  <div class="outline rounded w--full h--full flex flex--col">
    <div class="w--full flex flex--row flex--between flex--center-y gap--2 p--3 lg:p--4 {{ header_tone_class }}">
      <span class="font--small lg:font--base font--bold {{ header_tone_class }}">{{ department }}</span>
      <span class="font--small lg:font--base font--bold {{ header_tone_class }}">{{ tone_label }}</span>
    </div>
    <div class="divider"></div>

    <div class="flex flex--col flex--center-y gap--3 lg:gap--5 grow p--4 lg:p--6">
      <span class="label label--outline label--small lg:label--base">{{ case_state }}</span>
      <div class="w--full value value--xxlarge" data-value-fit="true" data-value-fit-max-height="150">
        <span>{{ headline | default: 'Unable to confirm.' }}</span>
      </div>
      <div class="description description--large lg:description--xxlarge">
        <span>{{ subheadline | default: 'Status check unavailable.' }}</span>
      </div>
      <div class="divider"></div>
      <div class="description description--small lg:description--large font--bold">
        <span>{{ footer | default: 'No evidence available.' }}</span>
      </div>
    </div>

    <div class="divider"></div>
    <div class="grid grid--cols-3">
      <div class="p--3 lg:p--4">
        <span class="label label--small">MORTALITY FILE</span>
        <span class="description description--small lg:description--base font--bold">{{ status_label }}</span>
      </div>
      <div class="border--v-black p--3 lg:p--4">
        <span class="label label--small">OBITUARY</span>
        <span class="description description--small lg:description--base font--bold">{{ obituary_state }}</span>
      </div>
      <div class="border--v-black p--3 lg:p--4">
        <span class="label label--small">COFFIN</span>
        <span class="description description--small lg:description--base font--bold">{{ coffin_state }}</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image image-stroke" alt="" src="data:image/svg+xml;base64,{{ mortality_icon | base64_encode }}">
  <span class="title">Is He Dead Yet?</span>
  <span class="instance">{{ subject | default: 'Unknown' }}</span>
</div>
