<div class="layout layout--col">
  <div class="outline rounded w--full h--full flex flex--col">
    <div class="w--full flex flex--row flex--between flex--center-y gap--1 p--2 lg:p--3 {{ header_tone_class }}">
      <span class="font--small font--bold {{ header_tone_class }}">{{ department }}</span>
      <span class="font--small font--bold {{ header_tone_class }}">{{ tone_label }}</span>
    </div>
    <div class="divider"></div>

    <div class="flex flex--col flex--center-y gap--1 lg:gap--2 grow p--2 lg:p--3">
      <span class="label label--outline label--xsmall lg:label--small">{{ case_state }}</span>
      <div class="w--full value lg:value--xlarge" data-value-fit="true" data-value-fit-max-height="72">
        <span>{{ headline | default: 'Unable to confirm.' }}</span>
      </div>
      <div class="description description--small lg:description--large">
        <span>{{ subheadline | default: 'Status check unavailable.' }}</span>
      </div>
      <div class="hidden lg:visible divider"></div>
      <div class="hidden lg:visible description description--small font--bold">
        <span>{{ footer | default: 'No evidence available.' }}</span>
      </div>
    </div>

    <div class="divider"></div>
    <div class="grid grid--cols-3">
      <div class="p--2">
        <span class="label label--xsmall">MORTALITY FILE</span>
        <span class="description description--xsmall font--bold">{{ status_label }}</span>
      </div>
      <div class="border--v-black p--2">
        <span class="label label--xsmall">OBITUARY</span>
        <span class="description description--xsmall font--bold">{{ obituary_state }}</span>
      </div>
      <div class="border--v-black p--2">
        <span class="label label--xsmall">COFFIN</span>
        <span class="description description--xsmall font--bold">{{ coffin_state }}</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image image-stroke" alt="" src="data:image/svg+xml;base64,{{ mortality_icon | base64_encode }}">
  <span class="title">Is He Dead Yet?</span>
  <span class="instance">{{ subject | default: 'Unknown' }}</span>
</div>
