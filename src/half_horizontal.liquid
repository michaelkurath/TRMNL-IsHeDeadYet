<div class="layout layout--col">
  <div class="mortality-card mortality-card--{{ selected_tone }} mortality-card--{{ status }} mortality-card--half_horizontal">
    <div class="mortality-card__header">
      <span class="mortality-card__department">{{ department }}</span>
      <span>{{ tone_label }}</span>
    </div>

    <div class="mortality-card__body">
      <span class="mortality-card__stamp">{{ case_state }}</span>
      <div class="value value--large lg:value--xlarge mortality-card__headline" data-value-fit="true" data-value-fit-max-height="75">
        <span>{{ headline | default: 'Unable to confirm.' }}</span>
      </div>
      <div class="description lg:description--large mortality-card__subheadline">
        <span>{{ subheadline | default: 'Status check unavailable.' }}</span>
      </div>
      <div class="mortality-card__evidence">
        <span>{{ footer | default: 'No evidence available.' }}</span>
      </div>
    </div>

    <div class="mortality-card__meta">
      <div class="mortality-card__meta-item">
        <span class="mortality-card__meta-label">MORTALITY FILE</span>
        <span class="mortality-card__meta-value">{{ status_label }}</span>
      </div>
      <div class="mortality-card__meta-item">
        <span class="mortality-card__meta-label">OBITUARY</span>
        <span class="mortality-card__meta-value">{{ obituary_state }}</span>
      </div>
      <div class="mortality-card__meta-item">
        <span class="mortality-card__meta-label">COFFIN</span>
        <span class="mortality-card__meta-value">{{ coffin_state }}</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image image-stroke" alt="" src="data:image/svg+xml;base64,{{ mortality_icon | base64_encode }}">
  <span class="title">Is He Dead Yet?</span>
  <span class="instance">{{ subject | default: 'Unknown' }}</span>
</div>
